# Copy this file to .env.local and paste your real values there.
# Never commit .env.local or share secret keys.

# --- AI (server only, secret) ---
# Get a key at https://openrouter.ai/settings/keys (it starts with sk-or-)
OPENROUTER_API_KEY=

# Optional: models used through OpenRouter
# OPENROUTER_MODEL=google/gemini-3.8-flash            (match ranking)
# OPENROUTER_FAST_MODEL=google/gemini-3.5-flash-lite  (intro + bike check)

# --- Supabase (accounts, database, photos, live chat) ---
# From Supabase → Project Settings → API. Both are PUBLIC by design (they're
# sent to the browser); the database's Row Level Security rules protect data.
# Leave them empty to run the device-only prototype instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
